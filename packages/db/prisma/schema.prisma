// SAMS Database Schema — Phases 1–15

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  ACCOUNTANT
  OPERATOR
  COMMITTEE
  AUDITOR
}

enum PermissionAction {
  CREATE
  READ
  UPDATE
  DELETE
  PRINT
  EXPORT
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
}

enum YearStorageMode {
  SAME_FILE
  SEPARATE_FILES
}

enum BillFrequency {
  MONTHLY
  BI_MONTHLY
  QUARTERLY
  QUADRUPLE
  HALF_YEARLY
  YEARLY
}

enum InterestPattern {
  NONE
  SIMPLE
  COMPOUND
}

enum SimpleInterestSubType {
  DELAY_DAYS
  DELAY_MONTHS
  COMPLETE_CYCLE
}

enum TariffMethod {
  SIMPLE
  ADVANCE
}

enum TariffScopeLevel {
  BUILDING
  WING
  UNIT
  COMPOSITION
  TYPE
  AREA
  PERSON
  FLOOR
}

enum TariffLineType {
  BOTH
  TENANT
}

enum BillRegisterDisplayMode {
  SHORT_CODE
  FULL_NAME
}

enum BillType {
  REGULAR
  SUPPLEMENTARY
}

enum BillToType {
  MEMBER
  TENANT
  GENERAL
}

enum BillStatus {
  DRAFT
  POSTED
  CANCELLED
}

enum BillLineType {
  CHARGE
  INTEREST
  NOC
  SERVICE_TAX
  REBATE
  ADJUSTMENT
  PARKING
}

enum SeriesType {
  MR
  GR
  CP
  BP
  CO
  JV
  DN
  CN
  RB
  SB
}

enum RebateType {
  PERCENT
  FIXED
}

enum BillNumberingMode {
  USER_INPUT
  AUTO_SERIAL
  BUILDING_WISE
}

enum LandType {
  FREEHOLD
  LEASEHOLD
}

enum FdStatus {
  ACTIVE
  MATURED
}

enum ReportType {
  BILL_REGULAR
  BILL_SUPPLEMENTARY
  RECEIPT_MEMBER
  RECEIPT_GENERAL
  CHEQUE
  MEETING_MINUTES
  MCACT_101
}

enum PageSize {
  A4
  LEGAL
}

enum AccountCategoryType {
  ASSET
  LIABILITY
  INCOME
  EXPENSE
}

enum AccountNature {
  DEBIT
  CREDIT
}

enum VoucherStatus {
  POSTED
  CANCELLED
}

enum UnitStatus {
  OCCUPIED
  VACANT
  ARCHIVED
}

enum ReferenceMasterType {
  UNIT_AREA
  UNIT_TYPE
  COMPOSITION
  FLOOR
}

enum MemberGender {
  MALE
  FEMALE
  OTHER
}

enum MaritalStatus {
  SINGLE
  MARRIED
  WIDOWED
  DIVORCED
}

enum OpeningBalanceType {
  REGULAR
  SUPPLEMENTARY
}

enum VoucherType {
  RECEIPT
  PAYMENT
  CONTRA
  JV
  DN
  CN
  PETTY_CASH
}

enum VoucherSubType {
  MEMBER_RECEIPT
  GENERAL_RECEIPT
  CASH_PAYMENT
  BANK_PAYMENT
}

enum ChequeType {
  CROSSED
  DD
  OUTSTATION
}

enum PartyType {
  VENDOR
  CONTRACTOR
  SOCIETY_BANK
  OTHER
}

model SystemMeta {
  id                Int             @id @default(1)
  schemaVersion     String
  appVersionCreated String
  isReadOnly        Boolean         @default(false)
  closedAt          DateTime?
  closedById        String?
  yearStorageMode   YearStorageMode @default(SEPARATE_FILES)
  closedBy          User?           @relation("ClosedByUser", fields: [closedById], references: [id])

  @@map("system_meta")
}

model User {
  id           String    @id @default(cuid())
  username     String    @unique
  passwordHash String
  displayName  String
  role         UserRole
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  createdBy    String
  updatedAt    DateTime  @updatedAt
  updatedBy    String
  auditLogs    AuditLog[]
  closedSystemMetas SystemMeta[] @relation("ClosedByUser")

  @@map("users")
}

model Permission {
  id       String           @id @default(cuid())
  role     UserRole
  resource String
  action   PermissionAction

  @@unique([role, resource, action])
  @@map("permissions")
}

model AuditLog {
  id           String      @id @default(cuid())
  userId       String
  action       AuditAction
  entityName   String
  entityId     String
  oldValueJson String?
  newValueJson String?
  timestamp    DateTime    @default(now())
  ipAddress    String?
  user         User        @relation(fields: [userId], references: [id])

  @@index([timestamp])
  @@index([entityName, entityId])
  @@map("audit_logs")
}

model SocietyIdentity {
  id                 String          @id @default(cuid())
  societyName        String
  registrationNumber String?
  registrationDate   DateTime?
  addressLine1       String?
  addressLine2       String?
  addressLine3       String?
  city               String?
  state              String?
  pinCode            String?
  telephone          String?
  fax                String?
  email              String?
  website            String?
  tan                String?
  pan                String?
  tdsCircle          String?
  createdAt          DateTime        @default(now())
  createdBy          String
  updatedAt          DateTime        @updatedAt
  updatedBy          String
  financialYears     FinancialYear[]
  societyParameters  SocietyParameters?
  propertyInformation PropertyInformation?
  reportFormatConfig ReportFormatConfig?

  @@map("society_identity")
}

model FinancialYear {
  id                 String          @id @default(cuid())
  label              String
  startDate          DateTime
  endDate            DateTime
  isClosed           Boolean         @default(false)
  previousYearDbPath String?
  societyIdentityId  String
  societyIdentity    SocietyIdentity @relation(fields: [societyIdentityId], references: [id])
  billingPeriods           BillingPeriodCalendar[]
  vouchers                 Voucher[]
  buildings                Building[]
  tariffDefinitions        TariffDefinition[]
  tariffSettlementSequences TariffSettlementSequence[]
  tariffBillRegisterMappings TariffBillRegisterMapping[]
  bills                      Bill[]
  voucherNumberSeries        VoucherNumberSeries[]
  fixedDeposits              FixedDepositRegister[]
  propertyRegisterEntries    PropertyRegisterEntry[]
  sinkingFundEntries         SinkingFundRegisterEntry[]
  iFormRegisters             IFormRegister[]
  tdsRecords                 TdsRecord[]
  tdsChallans                TdsChallan[]
  createdAt          DateTime        @default(now())
  createdBy          String
  updatedAt          DateTime        @updatedAt
  updatedBy          String

  @@map("financial_years")
}

model SocietyParameters {
  id                               String               @id @default("singleton")
  societyIdentityId                String               @unique
  societyIdentity                  SocietyIdentity      @relation(fields: [societyIdentityId], references: [id])
  billFrequency                    BillFrequency        @default(MONTHLY)
  billFrequencyChangedAt           DateTime?
  suppressZeroTariffs              Boolean              @default(true)
  mergeParkingOnBill               Boolean              @default(false)
  tariffDecimalPlaces              Int                  @default(2)
  regularInterestPattern           InterestPattern      @default(NONE)
  regularSimpleSubType             SimpleInterestSubType @default(DELAY_DAYS)
  regularInterestRate              Decimal              @default(0)
  regularInterestRoundToRupee      Boolean              @default(false)
  regularAllowManualOverride       Boolean              @default(false)
  supplementaryInterestPattern     InterestPattern      @default(NONE)
  supplementarySimpleSubType       SimpleInterestSubType @default(DELAY_DAYS)
  supplementaryInterestRate        Decimal              @default(0)
  supplementaryInterestRoundToRupee Boolean           @default(false)
  supplementaryAllowManualOverride Boolean              @default(false)
  tariffStructureBasis             String               @default("[\"UNIT\",\"BUILDING\"]")
  tariffMethod                     TariffMethod         @default(SIMPLE)
  shareCapitalGroupId              String?
  shareCapitalSubgroupId           String?
  bankSubgroupId                   String?
  cashSubgroupId                   String?
  memberSubgroupId                 String?
  tenantSubgroupId                 String?
  incomeExpenseSubgroupId          String?
  interestAccountId                String?
  adjustmentAccountId              String?
  nonOccupancyAccountId            String?
  serviceTaxAccountId              String?
  educationCessAccountId           String?
  nonOccupancyChargePercent        Decimal              @default(10)
  rebateType                       RebateType           @default(PERCENT)
  rebateValue                      Decimal              @default(0)
  serviceTaxPercent                Decimal              @default(0)
  educationCessPercent             Decimal              @default(0)
  gstPercent                       Decimal              @default(0)
  billNumberingMode                BillNumberingMode    @default(AUTO_SERIAL)
  bulkBillStartingNumber           Int                  @default(1)
  dualTypeUnitSupport              Boolean              @default(true)
  cashBankGroupId                  String?
  authorizedSignatory1             String?
  authorizedSignatory2             String?
  authorizedSignatory3             String?
  chequeSignatory1                 String?
  chequeSignatory2                 String?
  colourCodedGrids                 Boolean              @default(false)
  dueDateOffsetDays                Int                  @default(15)
  createdAt                        DateTime             @default(now())
  createdBy                        String
  updatedAt                        DateTime             @updatedAt
  updatedBy                        String

  @@map("society_parameters")
}

model PropertyInformation {
  id                           String      @id @default("singleton")
  societyIdentityId            String      @unique
  societyIdentity              SocietyIdentity @relation(fields: [societyIdentityId], references: [id])
  municipalHouseNo             String?
  surveySubDivisionNo          String?
  landType                     LandType?
  annualLeaseRent              Decimal?
  totalPlotAreaSqFt            Decimal?
  constructedAreaSqFt          Decimal?
  totalFlats                   Int?
  landCost                     Decimal?
  annualNonAgriAssessment      Decimal?
  buildingParticulars          String?
  completionCertificateDetails String?
  occupationCertificateDetails String?
  occupationDate               DateTime?
  municipalAssessmentYear      String?
  totalRateableValue           Decimal?
  dateOfConveyance             DateTime?
  remarks                      String?
  createdAt                    DateTime    @default(now())
  createdBy                    String
  updatedAt                    DateTime    @updatedAt
  updatedBy                    String

  @@map("property_information")
}

model ReportTemplate {
  id               String     @id @default(cuid())
  reportType       ReportType
  templateCode     String     @unique
  templateName     String
  htmlTemplatePath String
  cssPath          String?
  thumbnailPath    String?
  pageSize         PageSize   @default(A4)
  isActive         Boolean    @default(true)
  createdAt        DateTime   @default(now())
  createdBy        String
  updatedAt        DateTime   @updatedAt
  updatedBy        String

  @@map("report_templates")
}

model ReportFormatConfig {
  id                         String          @id @default("singleton")
  societyIdentityId          String          @unique
  societyIdentity            SocietyIdentity @relation(fields: [societyIdentityId], references: [id])
  billFormatId               String?
  supplementaryBillFormatId  String?
  receiptFormatId            String?
  generalReceiptFormatId     String?
  chequePrintFormatId        String?
  createdAt                  DateTime        @default(now())
  createdBy                  String
  updatedAt                  DateTime        @updatedAt
  updatedBy                  String

  @@map("report_format_config")
}

model BillingPeriodCalendar {
  id              String        @id @default(cuid())
  financialYearId String
  financialYear   FinancialYear @relation(fields: [financialYearId], references: [id], onDelete: Cascade)
  periodKey       String
  periodLabel     String
  periodStartDate DateTime
  periodEndDate   DateTime
  sequenceNo      Int
  createdAt       DateTime      @default(now())
  createdBy       String
  updatedAt       DateTime      @updatedAt
  updatedBy       String

  @@unique([financialYearId, periodKey])
  @@map("billing_period_calendar")
}

model AccountCategory {
  id        AccountCategoryType @id
  name      String
  sortOrder Int
  groups    AccountGroup[]

  @@map("account_categories")
}

model AccountGroup {
  id                  String              @id @default(cuid())
  categoryId          AccountCategoryType
  category            AccountCategory     @relation(fields: [categoryId], references: [id])
  groupName           String
  balanceSheetSr      Int
  nature              AccountNature
  substituteGroupName String?
  subgroups           AccountSubgroup[]
  createdAt           DateTime            @default(now())
  createdBy           String
  updatedAt           DateTime            @updatedAt
  updatedBy           String

  @@unique([categoryId, groupName])
  @@map("account_groups")
}

model AccountSubgroup {
  id                     String          @id @default(cuid())
  groupId                String
  group                  AccountGroup    @relation(fields: [groupId], references: [id])
  subgroupName           String
  subgroupSr             Int
  substituteSubgroupName String?
  accounts               AccountMaster[]
  createdAt              DateTime        @default(now())
  createdBy              String
  updatedAt              DateTime        @updatedAt
  updatedBy              String

  @@unique([groupId, subgroupName])
  @@map("account_subgroups")
}

model AccountMaster {
  id                   String          @id @default(cuid())
  subgroupId           String
  subgroup             AccountSubgroup @relation(fields: [subgroupId], references: [id])
  particulars          String
  openingBalanceDr     Decimal         @default(0)
  openingBalanceCr     Decimal         @default(0)
  previousYearAmount   Decimal         @default(0)
  estimateAmount       Decimal         @default(0)
  shortCode            String?         @unique
  serviceTaxApplicable Boolean         @default(false)
  rebateApplicable     Boolean         @default(false)
  interestFree         Boolean         @default(false)
  pettyCash            Boolean         @default(false)
  isActive             Boolean         @default(true)
  isArchived           Boolean         @default(false)
  archivedAt           DateTime?
  archivedBy           String?
  memberSubsidiaryId   String?         @unique
  memberSubsidiary     Member?            @relation("MemberSubsidiaryLedger", fields: [memberSubsidiaryId], references: [id])
  addressBookEntry              AddressBookEntry?
  tdsPartyRecords               TdsRecord[]       @relation("TdsPartyAccount")
  voucherLines                  VoucherLine[]
  parkingSpaces                 ParkingSpace[]
  tariffLines                   TariffLine[]
  tariffSettlementSequenceLines TariffSettlementSequenceLine[]
  tariffBillRegisterMappings    TariffBillRegisterMapping[]
  createdAt            DateTime        @default(now())
  createdBy            String
  updatedAt            DateTime        @updatedAt
  updatedBy            String

  @@map("account_masters")
}

model Voucher {
  id                    String                 @id @default(cuid())
  financialYearId       String
  financialYear         FinancialYear          @relation(fields: [financialYearId], references: [id])
  voucherType           VoucherType            @default(JV)
  subType               VoucherSubType?
  systemVoucherNo       String
  manualVoucherNo       String?
  voucherDate           DateTime
  narration             String                 @default("")
  narrationMasterId     String?
  reconciliationAudited Boolean                @default(false)
  recordAudited         Boolean                @default(false)
  status                VoucherStatus          @default(POSTED)
  reversalOfVoucherId   String?
  reversedByVoucherId   String?
  lines                 VoucherLine[]
  billSettlements       BillSettlement[]
  generalBillSettlements GeneralBillSettlement[]
  memberOpeningBalances MemberOpeningBalance[]
  sinkingFundEntries    SinkingFundRegisterEntry[]
  tdsRecords            TdsRecord[]
  createdAt             DateTime               @default(now())
  createdBy             String
  updatedAt             DateTime               @updatedAt
  updatedBy             String

  @@index([voucherDate])
  @@index([voucherType])
  @@map("vouchers")
}

model VoucherLine {
  id              String        @id @default(cuid())
  voucherId       String
  voucher         Voucher       @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  lineNo          Int
  accountMasterId String
  accountMaster   AccountMaster @relation(fields: [accountMasterId], references: [id])
  memberId        String?
  member          Member?       @relation(fields: [memberId], references: [id])
  drAmount        Decimal       @default(0)
  crAmount        Decimal       @default(0)
  particulars     String?
  bankAccountId   String?
  chequeDetail    ChequeDetail?
  tdsRecord       TdsRecord?
  createdAt       DateTime      @default(now())
  createdBy       String
  updatedAt       DateTime      @updatedAt
  updatedBy       String

  @@unique([voucherId, lineNo])
  @@index([accountMasterId])
  @@map("voucher_lines")
}

model Building {
  id              String        @id @default(cuid())
  financialYearId String
  financialYear   FinancialYear @relation(fields: [financialYearId], references: [id])
  shortName       String
  fullName        String
  totalUnits      Int           @default(0)
  numberOfFloors  Int           @default(0)
  deletedAt       DateTime?
  deletedById     String?
  wings           Wing[]
  units           Unit[]
  createdAt       DateTime      @default(now())
  createdBy       String
  updatedAt       DateTime      @updatedAt
  updatedBy       String

  @@unique([shortName])
  @@map("buildings")
}

model Wing {
  id         String    @id @default(cuid())
  buildingId String
  building   Building  @relation(fields: [buildingId], references: [id])
  shortName  String
  fullName   String
  deletedAt  DateTime?
  deletedById String?
  units      Unit[]
  createdAt  DateTime  @default(now())
  createdBy  String
  updatedAt  DateTime  @updatedAt
  updatedBy  String

  @@unique([buildingId, shortName])
  @@map("wings")
}

model UnitArea {
  id          String  @id @default(cuid())
  areaSqFt    Decimal
  description String?
  isActive    Boolean @default(true)
  units       Unit[]
  createdAt   DateTime @default(now())
  createdBy   String
  updatedAt   DateTime @updatedAt
  updatedBy   String

  @@map("unit_areas")
}

model UnitType {
  id        String  @id @default(cuid())
  typeName  String  @unique
  isActive  Boolean @default(true)
  units     Unit[]
  createdAt DateTime @default(now())
  createdBy String
  updatedAt DateTime @updatedAt
  updatedBy String

  @@map("unit_types")
}

model UnitComposition {
  id              String  @id @default(cuid())
  compositionName String  @unique
  isActive        Boolean @default(true)
  units           Unit[]
  createdAt       DateTime @default(now())
  createdBy       String
  updatedAt       DateTime @updatedAt
  updatedBy       String

  @@map("unit_compositions")
}

model FloorMaster {
  id        String  @id @default(cuid())
  srNo      Int
  floorName String
  isActive  Boolean @default(true)
  units     Unit[]
  createdAt DateTime @default(now())
  createdBy String
  updatedAt DateTime @updatedAt
  updatedBy String

  @@unique([srNo])
  @@map("floor_masters")
}

model Unit {
  id                       String           @id @default(cuid())
  buildingId               String
  building                 Building         @relation(fields: [buildingId], references: [id])
  wingId                   String
  wing                     Wing             @relation(fields: [wingId], references: [id])
  unitNo                   String
  floorMasterId            String?
  floorMaster              FloorMaster?     @relation(fields: [floorMasterId], references: [id])
  unitTypeId               String?
  unitType                 UnitType?        @relation(fields: [unitTypeId], references: [id])
  unitCompositionId        String?
  unitComposition          UnitComposition? @relation(fields: [unitCompositionId], references: [id])
  unitAreaId               String?
  unitArea                 UnitArea?        @relation(fields: [unitAreaId], references: [id])
  carpetAreaSqFt           Decimal?
  residentialAreaSqFt      Decimal?
  commercialAreaSqFt       Decimal?
  residentialRateableValue Decimal?
  commercialRateableValue Decimal?
  serialNo                 Int
  status                   UnitStatus       @default(VACANT)
  constructionValue        Decimal?
  landValue                Decimal?
  deletedAt                DateTime?
  deletedById              String?
  members                  Member[]
  tenants                  Tenant[]
  createdAt                DateTime         @default(now())
  createdBy                String
  updatedAt                DateTime         @updatedAt
  updatedBy                String

  @@unique([buildingId, wingId, unitNo])
  @@index([serialNo])
  @@map("units")
}

model ParkingTariffType {
  id        String              @id @default(cuid())
  typeName  String              @unique
  isActive  Boolean             @default(true)
  rates     ParkingTariffRate[]
  spaces    ParkingSpace[]
  createdAt DateTime            @default(now())
  createdBy String
  updatedAt DateTime            @updatedAt
  updatedBy String

  @@map("parking_tariff_types")
}

model ParkingTariffRate {
  id                  String            @id @default(cuid())
  parkingTariffTypeId String
  parkingTariffType   ParkingTariffType @relation(fields: [parkingTariffTypeId], references: [id], onDelete: Cascade)
  effectiveDate       DateTime
  monthlyRate         Decimal
  createdAt           DateTime          @default(now())
  createdBy           String
  updatedAt           DateTime          @updatedAt
  updatedBy           String

  @@unique([parkingTariffTypeId, effectiveDate])
  @@map("parking_tariff_rates")
}

model ParkingSpace {
  id                  String            @id @default(cuid())
  parkingNo           String            @unique
  parkingTariffTypeId String
  parkingTariffType   ParkingTariffType @relation(fields: [parkingTariffTypeId], references: [id])
  chargeAccountId     String
  chargeAccount       AccountMaster     @relation(fields: [chargeAccountId], references: [id])
  isActive            Boolean           @default(true)
  assignments         MemberParkingAssignment[]
  createdAt           DateTime          @default(now())
  createdBy           String
  updatedAt           DateTime          @updatedAt
  updatedBy           String

  @@map("parking_spaces")
}

model Member {
  id                           String    @id @default(cuid())
  unitId                       String
  unit                         Unit      @relation(fields: [unitId], references: [id])
  title                        String?
  memberName                   String
  tenantOccupancy              Boolean   @default(false)
  tenantOccupancyEffectiveFrom DateTime?
  generateRegularBills         Boolean   @default(true)
  generateSupplementaryBills   Boolean   @default(true)
  chargeInterest               Boolean   @default(true)
  disposedAt                   DateTime?
  disposeReason                String?
  photographPath               String?
  gender                       MemberGender?
  dateOfBirth                  DateTime?
  qualification                String?
  religion                     String?
  occupation                   String?
  panNo                        String?
  bloodGroup                   String?
  maritalStatus                MaritalStatus?
  anniversaryType              String?
  anniversaryDate              DateTime?
  unitPurchaseDate             DateTime?
  dateOfSale                   DateTime?
  associateMember              String?
  jointMember                  String?
  votingRightsMember           String?
  memberBankName               String?
  memberBankBranch             String?
  totalFamilyMembers           Int?
  memberClass                  String?
  clubMembershipDeposit        Decimal?
  address                      String?
  residencePhone               String?
  officePhone                  String?
  emailPrimary                 String?
  emailSecondary               String?
  fax                          String?
  subsidiaryLedger             AccountMaster? @relation("MemberSubsidiaryLedger")
  dependents                   MemberDependent[]
  nominees                     MemberNominee[]
  vehicles                     MemberVehicle[]
  shares                       MemberShare[]
  housingLoans                 MemberHousingLoan[]
  openingBalances              MemberOpeningBalance[]
  parkingAssignments           MemberParkingAssignment[]
  voucherLines                 VoucherLine[]
  bills                        Bill[]
  propertyRegisterEntries      PropertyRegisterEntry[]
  sinkingFundEntries           SinkingFundRegisterEntry[]
  iFormRegister                IFormRegister?
  createdAt                    DateTime  @default(now())
  createdBy                    String
  updatedAt                    DateTime  @updatedAt
  updatedBy                    String

  @@index([unitId])
  @@index([disposedAt])
  @@map("members")
}

model MemberDependent {
  id          String        @id @default(cuid())
  memberId    String
  member      Member        @relation(fields: [memberId], references: [id], onDelete: Cascade)
  name        String
  relation    String?
  occupation  String?
  age         Int?
  gender      MemberGender?
  dateOfBirth DateTime?
  idCardNo    String?
  bloodGroup  String?
  createdAt   DateTime      @default(now())
  createdBy   String
  updatedAt   DateTime      @updatedAt
  updatedBy   String

  @@map("member_dependents")
}

model MemberNominee {
  id                   String    @id @default(cuid())
  memberId             String
  member               Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  nominationDate       DateTime?
  nomineeName          String
  committeeMeetingDate DateTime?
  subject              String?
  revocationDate       DateTime?
  remark               String?
  createdAt            DateTime  @default(now())
  createdBy            String
  updatedAt            DateTime  @updatedAt
  updatedBy            String

  @@map("member_nominees")
}

model MemberVehicle {
  id               String    @id @default(cuid())
  memberId         String
  member           Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  vehicleName      String?
  vehicleNo        String?
  registrationNo   String?
  registrationDate DateTime?
  createdAt        DateTime  @default(now())
  createdBy        String
  updatedAt        DateTime  @updatedAt
  updatedBy        String

  @@map("member_vehicles")
}

model MemberShare {
  id              String    @id @default(cuid())
  memberId        String
  member          Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  allotmentDate   DateTime?
  certificateNo   String?
  folioNo         String?
  numberOfShares  Int?
  fromShareNo     String?
  toShareNo       String?
  createdAt       DateTime  @default(now())
  createdBy       String
  updatedAt       DateTime  @updatedAt
  updatedBy       String

  @@map("member_shares")
}

model MemberHousingLoan {
  id         String    @id @default(cuid())
  memberId   String
  member     Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  bankName   String?
  branchName String?
  nocDate    DateTime?
  loanAmount Decimal?
  remark     String?
  createdAt  DateTime  @default(now())
  createdBy  String
  updatedAt  DateTime  @updatedAt
  updatedBy  String

  @@map("member_housing_loans")
}

